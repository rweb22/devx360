# DevX360 Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Multi-Tenant Configuration
BASE_DOMAIN=devx360.in
BASE_URL=http://localhost:3000

# Branding
BRAND_NAME=DevX360
BRAND_EMAIL=contact@devx360.in

# GitHub Gist for Temporary Tenants (optional)
# Create a gist at https://gist.github.com with a file named tenants.json
# Then paste the gist ID here (the alphanumeric part from the URL)
GIST_ID=

# Admin Authentication (JWT-based)
# Generate JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# Admin Password Hash
# Generate hash: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(console.log)"
# Default password in development (no hash set): "admin"
ADMIN_PASSWORD_HASH=

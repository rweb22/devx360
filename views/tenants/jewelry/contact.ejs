<section style="background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(201, 169, 97, 0.1) 100%); padding: 4rem 0; text-align: center;">
    <div class="container">
        <h1 style="font-size: 3.5rem; margin-bottom: 1rem; font-weight: 700; color: var(--jewelry-dark);">Contact Us</h1>
        <p style="font-size: 1.25rem; color: #666;">We're here to help you find the perfect piece</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem; margin-bottom: 4rem;">
            <div style="background: white; padding: 2.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: var(--jewelry-light); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📍</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--jewelry-dark);">Showroom</h3>
                <p style="color: #666; line-height: 1.8;">123 Luxury Avenue<br>New York, NY 10001</p>
            </div>
            <div style="background: white; padding: 2.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: var(--jewelry-light); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📞</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--jewelry-dark);">Phone</h3>
                <p style="color: #666; line-height: 1.8;">(555) 123-GEMS<br>Mon-Sat: 10AM - 8PM</p>
            </div>
            <div style="background: white; padding: 2.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: var(--jewelry-light); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">✉️</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--jewelry-dark);">Email</h3>
                <p style="color: #666; line-height: 1.8;">hello@lumiere-jewelry.demo<br>24 hour response time</p>
            </div>
        </div>

        <div style="max-width: 800px; margin: 0 auto;">
            <h2 style="font-size: 2.5rem; margin-bottom: 2rem; text-align: center; color: var(--jewelry-dark);">Book a Consultation</h2>
            <div style="background: white; padding: 3rem; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                <form style="display: grid; gap: 1.5rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--jewelry-dark);">Name *</label>
                            <input type="text" required style="width: 100%; padding: 1rem; border: 2px solid #e5e5e5; border-radius: 4px; font-size: 1rem;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--jewelry-dark);">Email *</label>
                            <input type="email" required style="width: 100%; padding: 1rem; border: 2px solid #e5e5e5; border-radius: 4px; font-size: 1rem;">
                        </div>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--jewelry-dark);">Phone</label>
                        <input type="tel" style="width: 100%; padding: 1rem; border: 2px solid #e5e5e5; border-radius: 4px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--jewelry-dark);">I'm interested in *</label>
                        <select required style="width: 100%; padding: 1rem; border: 2px solid #e5e5e5; border-radius: 4px; font-size: 1rem;">
                            <option value="">Select category</option>
                            <option value="engagement">Engagement Rings</option>
                            <option value="rings">Rings</option>
                            <option value="necklaces">Necklaces</option>
                            <option value="earrings">Earrings</option>
                            <option value="bracelets">Bracelets</option>
                            <option value="custom">Custom Design</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--jewelry-dark);">Message</label>
                        <textarea rows="5" style="width: 100%; padding: 1rem; border: 2px solid #e5e5e5; border-radius: 4px; font-size: 1rem; font-family: inherit;"></textarea>
                    </div>
                    <button type="submit" style="background: var(--jewelry-primary); color: white; padding: 1.25rem 2rem; border: none; border-radius: 4px; font-size: 1.1rem; font-weight: 600; cursor: pointer; letter-spacing: 1px; margin-top: 1rem;" onclick="alert('This is a demo. In production, your consultation request would be sent to our team!'); return false;">
                        REQUEST CONSULTATION
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

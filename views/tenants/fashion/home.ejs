<!-- Hero Section -->
<section style="background: #f5f5f5; padding: 8rem 0; text-align: center;">
    <div class="container">
        <p style="color: #666; font-size: 0.85rem; letter-spacing: 3px; margin-bottom: 2rem; font-family: sans-serif; text-transform: uppercase;">Spring Summer 2024</p>
        <h1 style="font-size: 5rem; margin-bottom: 2rem; font-weight: 300; letter-spacing: 4px; color: #1a1a1a;">TIMELESS ELEGANCE</h1>
        <p style="font-size: 1.25rem; margin-bottom: 3rem; color: #666; max-width: 600px; margin-left: auto; margin-right: auto; font-family: sans-serif; line-height: 1.8;">Discover our carefully curated collection of haute couture pieces that define sophistication</p>
        <div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;">
            <a href="/fashion/collections" style="background: #1a1a1a; color: white; padding: 1.25rem 3rem; text-decoration: none; letter-spacing: 2px; font-size: 0.85rem; font-family: sans-serif; transition: background 0.3s; text-transform: uppercase;">Shop Collection</a>
            <a href="/fashion/lookbook" style="border: 1px solid #1a1a1a; color: #1a1a1a; padding: 1.25rem 3rem; text-decoration: none; letter-spacing: 2px; font-size: 0.85rem; font-family: sans-serif; transition: all 0.3s; text-transform: uppercase;">View Lookbook</a>
        </div>
    </div>
</section>

<!-- Featured Categories -->
<section class="section">
    <div class="container">
        <div style="text-align: center; margin-bottom: 5rem;">
            <h2 style="font-size: 3.5rem; margin-bottom: 1.5rem; font-weight: 300; letter-spacing: 3px; color: #1a1a1a;">SHOP BY CATEGORY</h2>
            <p style="font-size: 1rem; color: #666; font-family: sans-serif;">Explore our signature collections</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 2rem;">
            <div style="position: relative; overflow: hidden; cursor: pointer; height: 500px; background: #e8e8e8; display: flex; align-items: flex-end; justify-content: center;">
                <div style="padding: 3rem; text-align: center; background: rgba(255,255,255,0.95); width: 100%;">
                    <h3 style="font-size: 2rem; margin-bottom: 0.75rem; font-weight: 300; letter-spacing: 3px; color: #1a1a1a;">WOMEN'S</h3>
                    <p style="color: #666; margin-bottom: 1.5rem; font-family: sans-serif; font-size: 0.9rem;">Refined femininity</p>
                    <a href="/fashion/collections" style="color: #1a1a1a; text-decoration: none; letter-spacing: 2px; font-size: 0.85rem; border-bottom: 1px solid #1a1a1a; padding-bottom: 0.25rem; font-family: sans-serif; text-transform: uppercase;">Explore →</a>
                </div>
            </div>
            <div style="position: relative; overflow: hidden; cursor: pointer; height: 500px; background: #d8d8d8; display: flex; align-items: flex-end; justify-content: center;">
                <div style="padding: 3rem; text-align: center; background: rgba(255,255,255,0.95); width: 100%;">
                    <h3 style="font-size: 2rem; margin-bottom: 0.75rem; font-weight: 300; letter-spacing: 3px; color: #1a1a1a;">MEN'S</h3>
                    <p style="color: #666; margin-bottom: 1.5rem; font-family: sans-serif; font-size: 0.9rem;">Modern sophistication</p>
                    <a href="/fashion/collections" style="color: #1a1a1a; text-decoration: none; letter-spacing: 2px; font-size: 0.85rem; border-bottom: 1px solid #1a1a1a; padding-bottom: 0.25rem; font-family: sans-serif; text-transform: uppercase;">Explore →</a>
                </div>
            </div>
            <div style="position: relative; overflow: hidden; cursor: pointer; height: 500px; background: #c8c8c8; display: flex; align-items: flex-end; justify-content: center;">
                <div style="padding: 3rem; text-align: center; background: rgba(255,255,255,0.95); width: 100%;">
                    <h3 style="font-size: 2rem; margin-bottom: 0.75rem; font-weight: 300; letter-spacing: 3px; color: #1a1a1a;">ACCESSORIES</h3>
                    <p style="color: #666; margin-bottom: 1.5rem; font-family: sans-serif; font-size: 0.9rem;">Signature details</p>
                    <a href="/fashion/collections" style="color: #1a1a1a; text-decoration: none; letter-spacing: 2px; font-size: 0.85rem; border-bottom: 1px solid #1a1a1a; padding-bottom: 0.25rem; font-family: sans-serif; text-transform: uppercase;">Explore →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Philosophy -->
<section class="section" style="background: #1a1a1a; color: white; text-align: center;">
    <div class="container" style="max-width: 900px;">
        <p style="color: #888; font-size: 0.85rem; letter-spacing: 3px; margin-bottom: 2rem; font-family: sans-serif; text-transform: uppercase;">Our Philosophy</p>
        <h2 style="font-size: 3rem; margin-bottom: 2rem; font-weight: 300; letter-spacing: 3px; line-height: 1.4;">WHERE ARTISTRY MEETS CRAFTSMANSHIP</h2>
        <p style="font-size: 1.1rem; color: #b0b0b0; line-height: 1.9; font-family: sans-serif; margin-bottom: 3rem;">Each piece in our collection is meticulously crafted by master artisans, combining traditional techniques with contemporary design. We believe in creating garments that transcend seasons and trends.</p>
        <a href="/fashion/about" style="color: white; text-decoration: none; letter-spacing: 2px; font-size: 0.85rem; border-bottom: 1px solid white; padding-bottom: 0.25rem; font-family: sans-serif; text-transform: uppercase;">Discover Our Story →</a>
    </div>
</section>

<!-- New Arrivals -->
<section class="section">
    <div class="container">
        <div style="text-align: center; margin-bottom: 5rem;">
            <h2 style="font-size: 3.5rem; margin-bottom: 1.5rem; font-weight: 300; letter-spacing: 3px; color: #1a1a1a;">NEW ARRIVALS</h2>
            <p style="font-size: 1rem; color: #666; font-family: sans-serif;">Latest additions to our collection</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem;">
            <% 
            const products = [
                {name: 'Silk Evening Gown', category: 'Dresses', price: '$2,850', bg: '#f0e6dc'},
                {name: 'Cashmere Overcoat', category: 'Outerwear', price: '$3,200', bg: '#e8dcd0'},
                {name: 'Tailored Blazer', category: 'Jackets', price: '$1,450', bg: '#dcd0c4'},
                {name: 'Leather Handbag', category: 'Accessories', price: '$980', bg: '#d0c4b8'}
            ];
            
            products.forEach(product => { %>
                <div>
                    <div style="height: 400px; background: <%= product.bg %>; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 4rem;">👗</div>
                    <div style="text-align: center;">
                        <p style="color: #888; font-size: 0.8rem; letter-spacing: 2px; margin-bottom: 0.5rem; font-family: sans-serif; text-transform: uppercase;"><%= product.category %></p>
                        <h3 style="font-size: 1.5rem; margin-bottom: 0.75rem; font-weight: 300; letter-spacing: 2px; color: #1a1a1a;"><%= product.name %></h3>
                        <p style="font-size: 1.25rem; color: #1a1a1a; margin-bottom: 1.5rem; font-family: sans-serif;"><%= product.price %></p>
                        <a href="/fashion/collections" style="color: #1a1a1a; text-decoration: none; letter-spacing: 2px; font-size: 0.85rem; border-bottom: 1px solid #1a1a1a; padding-bottom: 0.25rem; font-family: sans-serif; text-transform: uppercase;">View Details</a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Newsletter -->
<section class="section" style="background: #f5f5f5; text-align: center;">
    <div class="container" style="max-width: 700px;">
        <h2 style="font-size: 3rem; margin-bottom: 1.5rem; font-weight: 300; letter-spacing: 3px; color: #1a1a1a;">STAY UPDATED</h2>
        <p style="font-size: 1rem; color: #666; margin-bottom: 3rem; font-family: sans-serif; line-height: 1.8;">Subscribe to our newsletter for exclusive access to new collections and private sales</p>
        <div style="display: flex; gap: 0; max-width: 500px; margin: 0 auto;">
            <input type="email" placeholder="Your email address" style="flex: 1; padding: 1.25rem 1.5rem; border: 1px solid #d0d0d0; font-size: 0.9rem; font-family: sans-serif; color: #1a1a1a;">
            <button style="background: #1a1a1a; color: white; padding: 1.25rem 2.5rem; border: none; cursor: pointer; letter-spacing: 2px; font-size: 0.85rem; font-family: sans-serif; text-transform: uppercase;">Subscribe</button>
        </div>
    </div>
</section>

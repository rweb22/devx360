<section style="background: #f5f5f5; padding: 5rem 0; text-align: center;">
    <div class="container">
        <h1 style="font-size: 4rem; margin-bottom: 1rem; font-weight: 300; letter-spacing: 4px; color: #1a1a1a;">GET IN TOUCH</h1>
        <p style="font-size: 1rem; color: #666; font-family: sans-serif;">We're here to assist you</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; margin-bottom: 5rem;">
            <div style="text-align: center; padding: 3rem 2rem;">
                <div style="width: 80px; height: 80px; background: #e8e8e8; border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📍</div>
                <h3 style="font-size: 1.35rem; margin-bottom: 1rem; font-weight: 300; letter-spacing: 2px; color: #1a1a1a;">FLAGSHIP BOUTIQUE</h3>
                <p style="color: #666; line-height: 1.8; font-family: sans-serif;">5th Avenue<br>New York, NY 10022</p>
            </div>
            <div style="text-align: center; padding: 3rem 2rem;">
                <div style="width: 80px; height: 80px; background: #e8e8e8; border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📞</div>
                <h3 style="font-size: 1.35rem; margin-bottom: 1rem; font-weight: 300; letter-spacing: 2px; color: #1a1a1a;">PHONE</h3>
                <p style="color: #666; line-height: 1.8; font-family: sans-serif;">(555) STYLE-01<br>Mon-Sat: 10AM - 8PM</p>
            </div>
            <div style="text-align: center; padding: 3rem 2rem;">
                <div style="width: 80px; height: 80px; background: #e8e8e8; border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">✉️</div>
                <h3 style="font-size: 1.35rem; margin-bottom: 1rem; font-weight: 300; letter-spacing: 2px; color: #1a1a1a;">EMAIL</h3>
                <p style="color: #666; line-height: 1.8; font-family: sans-serif;">hello@elegance-fashion.demo<br>24-hour response time</p>
            </div>
        </div>

        <div style="max-width: 700px; margin: 0 auto;">
            <h2 style="font-size: 3rem; margin-bottom: 3rem; text-align: center; font-weight: 300; letter-spacing: 3px; color: #1a1a1a;">SEND A MESSAGE</h2>
            <form style="display: grid; gap: 2rem;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-family: sans-serif; font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase; color: #666;">Name</label>
                        <input type="text" required style="width: 100%; padding: 1rem; border: 1px solid #d0d0d0; font-size: 1rem; font-family: sans-serif; color: #1a1a1a;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-family: sans-serif; font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase; color: #666;">Email</label>
                        <input type="email" required style="width: 100%; padding: 1rem; border: 1px solid #d0d0d0; font-size: 1rem; font-family: sans-serif; color: #1a1a1a;">
                    </div>
                </div>
                <div>
                    <label style="display: block; margin-bottom: 0.75rem; font-family: sans-serif; font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase; color: #666;">Phone</label>
                    <input type="tel" style="width: 100%; padding: 1rem; border: 1px solid #d0d0d0; font-size: 1rem; font-family: sans-serif; color: #1a1a1a;">
                </div>
                <div>
                    <label style="display: block; margin-bottom: 0.75rem; font-family: sans-serif; font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase; color: #666;">Subject</label>
                    <select required style="width: 100%; padding: 1rem; border: 1px solid #d0d0d0; font-size: 1rem; font-family: sans-serif; color: #1a1a1a;">
                        <option value="">Select subject</option>
                        <option value="styling">Personal Styling</option>
                        <option value="order">Order Inquiry</option>
                        <option value="appointment">Book Appointment</option>
                        <option value="general">General Inquiry</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; margin-bottom: 0.75rem; font-family: sans-serif; font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase; color: #666;">Message</label>
                    <textarea rows="6" required style="width: 100%; padding: 1rem; border: 1px solid #d0d0d0; font-size: 1rem; font-family: sans-serif; color: #1a1a1a;"></textarea>
                </div>
                <button type="submit" style="background: #1a1a1a; color: white; padding: 1.25rem 2rem; border: none; cursor: pointer; letter-spacing: 2px; font-size: 0.85rem; font-family: sans-serif; text-transform: uppercase; margin-top: 1rem;" onclick="alert('This is a demo. In production, your message would be sent!'); return false;">
                    SEND MESSAGE
                </button>
            </form>
        </div>
    </div>
</section>

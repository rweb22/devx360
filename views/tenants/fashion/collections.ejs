<section style="background: #f5f5f5; padding: 5rem 0; text-align: center;">
    <div class="container">
        <h1 style="font-size: 4rem; margin-bottom: 1rem; font-weight: 300; letter-spacing: 4px; color: #1a1a1a;">COLLECTIONS</h1>
        <p style="font-size: 1rem; color: #666; font-family: sans-serif;">Curated pieces for the modern wardrobe</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 4rem;">
            <% 
            const items = [
                {name: 'Silk Evening Gown', category: 'Evening Wear', price: '$2,850', color: '#f0e6dc'},
                {name: 'Cashmere Overcoat', category: 'Outerwear', price: '$3,200', color: '#e8dcd0'},
                {name: 'Tailored Blazer', category: 'Suiting', price: '$1,450', color: '#dcd0c4'},
                {name: 'Leather Handbag', category: 'Accessories', price: '$980', color: '#d0c4b8'},
                {name: 'Merino Wool Sweater', category: 'Knitwear', price: '$650', color: '#c4b8ac'},
                {name: 'Italian Leather Loafers', category: 'Footwear', price: '$720', color: '#b8aca0'},
                {name: 'Silk Scarf', category: 'Accessories', price: '$340', color: '#aca094'},
                {name: 'Classic Trench Coat', category: 'Outerwear', price: '$1,890', color: '#a09488'},
                {name: 'Pleated Midi Skirt', category: 'Bottoms', price: '$780', color: '#94887c'},
                {name: 'Structured Shoulder Bag', category: 'Accessories', price: '$1,250', color: '#887c70'},
                {name: 'Wool Dress Pants', category: 'Suiting', price: '$580', color: '#7c7064'},
                {name: 'Silk Blouse', category: 'Tops', price: '$520', color: '#706458'}
            ];
            
            items.forEach(item => { %>
                <div>
                    <div style="height: 450px; background: <%= item.color %>; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 5rem; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                        <% if (item.category === 'Accessories') { %>🎒
                        <% } else if (item.category === 'Footwear') { %>👞
                        <% } else { %>👗<% } %>
                    </div>
                    <div style="text-align: center;">
                        <p style="color: #888; font-size: 0.75rem; letter-spacing: 2px; margin-bottom: 0.5rem; font-family: sans-serif; text-transform: uppercase;"><%= item.category %></p>
                        <h3 style="font-size: 1.35rem; margin-bottom: 0.75rem; font-weight: 300; letter-spacing: 2px; color: #1a1a1a;"><%= item.name %></h3>
                        <p style="font-size: 1.15rem; color: #1a1a1a; margin-bottom: 1.5rem; font-family: sans-serif;"><%= item.price %></p>
                        <button style="background: #1a1a1a; color: white; padding: 0.875rem 2rem; border: none; cursor: pointer; letter-spacing: 2px; font-size: 0.8rem; font-family: sans-serif; text-transform: uppercase;" onclick="alert('This is a demo. In production, this would add to cart!')">Add to Cart</button>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

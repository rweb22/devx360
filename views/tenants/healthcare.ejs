<!-- Healthcare Demo Template -->

<!-- Hero Section -->
<section class="hero section" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text animate-on-scroll" style="text-align: center; color: white;">
                <h1 class="hero-title" style="color: white;">
                    <%= hero.title %>
                </h1>
                <p class="hero-subtitle" style="color: rgba(255, 255, 255, 0.9); font-size: 1.25rem;">
                    <%= hero.subtitle %>
                </p>
                <div class="hero-cta" style="margin-top: 2rem;">
                    <a href="#appointments" class="btn btn-primary" style="background: white; color: #0ea5e9; font-weight: 600;">
                        <%= hero.cta %>
                    </a>
                    <a href="#services" class="btn btn-secondary" style="background: transparent; border: 2px solid white; color: white;">
                        Our Services
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section" style="padding: 4rem 0; background: #f8f9fa;">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem;">Platform Features</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
            <% features.forEach(feature => { %>
                <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;"><%= feature.icon %></div>
                    <h3 style="margin-bottom: 0.75rem; font-size: 1.5rem;"><%= feature.title %></h3>
                    <p style="color: #666; line-height: 1.6;"><%= feature.description %></p>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="section" id="services" style="padding: 4rem 0;">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem;">Medical Services</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; max-width: 1000px; margin: 0 auto;">
            <% services.forEach(service => { %>
                <div style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; padding: 2rem; border-radius: 12px; text-align: center;">
                    <h3 style="margin-bottom: 0.5rem; font-size: 1.5rem; color: white;"><%= service.name %></h3>
                    <p style="font-size: 1.75rem; font-weight: bold; margin: 0;"><%= service.doctors %> Doctors</p>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="section" style="padding: 4rem 0; background: #0ea5e9; color: white;">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center;">
            <% stats.forEach(stat => { %>
                <div>
                    <div style="font-size: 3rem; font-weight: bold; margin-bottom: 0.5rem;"><%= stat.value %></div>
                    <div style="font-size: 1.25rem; opacity: 0.9;"><%= stat.label %></div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Demo Notice -->
<section class="section" style="padding: 3rem 0; background: #d1ecf1; border-top: 3px solid #0ea5e9;">
    <div class="container">
        <div style="text-align: center;">
            <h3 style="color: #0c5460; margin-bottom: 1rem;">🏥 This is a Demo Website</h3>
            <p style="color: #0c5460; font-size: 1.1rem; max-width: 700px; margin: 0 auto;">
                This healthcare demo demonstrates DevX360's capabilities in building secure, HIPAA-compliant healthcare platforms.
                Need a custom healthcare solution?
            </p>
            <a href="https://devx360.in/contact" style="display: inline-block; margin-top: 1.5rem; padding: 0.75rem 2rem; background: #0c5460; color: white; text-decoration: none; border-radius: 8px; font-weight: 600;">
                Contact DevX360
            </a>
        </div>
    </div>
</section>

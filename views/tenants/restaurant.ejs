<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
        .tenant-hero { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 6rem 0 4rem; min-height: 60vh; display: flex; align-items: center; }
        .section { padding: 4rem 0; }
    </style>
</head>
<body>

<!-- Hero Section -->
<section class="tenant-hero">
    <div class="container">
        <div style="text-align: center; max-width: 800px; margin: 0 auto;">
            <h1 style="font-size: 3rem; margin-bottom: 1.5rem; font-weight: 700;">
                <%= hero.title %>
            </h1>
            <p style="font-size: 1.25rem; margin-bottom: 2rem; opacity: 0.95;">
                <%= hero.subtitle %>
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="#menu" style="background: white; color: #667eea; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 600;">
                    <%= hero.cta %>
                </a>
                <a href="#features" style="background: transparent; border: 2px solid white; color: white; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 600;">
                    Learn More
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="section" style="background: #f8f9fa;">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem; color: #333;">Our Features</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 2rem;">
            <% features.forEach(feature => { %>
                <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center; transition: transform 0.3s;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;"><%= feature.icon %></div>
                    <h3 style="margin-bottom: 0.75rem; font-size: 1.25rem; color: #333;"><%= feature.title %></h3>
                    <p style="color: #666; line-height: 1.6; font-size: 0.95rem;"><%= feature.description %></p>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Menu Categories -->
<section id="menu" class="section" style="background: white;">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem; color: #333;">Menu Categories</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; max-width: 900px; margin: 2rem auto 0;">
            <% menu.forEach(item => { %>
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem 1.5rem; border-radius: 12px; text-align: center; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
                    <h3 style="margin-bottom: 0.5rem; font-size: 1.25rem; color: white;"><%= item.category %></h3>
                    <p style="font-size: 1.75rem; font-weight: bold; margin: 0;"><%= item.count %> items</p>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="section" style="background: #667eea; color: white;">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem; color: white;">Our Numbers</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 3rem; text-align: center; margin-top: 2rem;">
            <% stats.forEach(stat => { %>
                <div>
                    <div style="font-size: 3rem; font-weight: bold; margin-bottom: 0.5rem;"><%= stat.value %></div>
                    <div style="font-size: 1.1rem; opacity: 0.9;"><%= stat.label %></div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Demo Notice -->
<section class="section" style="padding: 3rem 0; background: #fff3cd; border-top: 3px solid #ffc107;">
    <div class="container">
        <div style="text-align: center;">
            <h3 style="color: #856404; margin-bottom: 1rem;">🎯 This is a Demo Website</h3>
            <p style="color: #856404; font-size: 1.1rem; max-width: 700px; margin: 0 auto;">
                This restaurant demo showcases how DevX360 can build custom solutions for the food service industry. 
                Interested in a similar platform for your business?
            </p>
            <a href="https://devx360.in/contact" style="display: inline-block; margin-top: 1.5rem; padding: 0.75rem 2rem; background: #856404; color: white; text-decoration: none; border-radius: 8px; font-weight: 600;">
                Contact DevX360
            </a>
        </div>
    </div>
</section>

</body>
</html>

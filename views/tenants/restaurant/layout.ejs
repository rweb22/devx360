<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        
        /* Restaurant Theme Colors */
        :root {
            --restaurant-primary: #667eea;
            --restaurant-secondary: #764ba2;
            --restaurant-accent: #f59e0b;
        }
        
        /* Navigation */
        .restaurant-nav {
            background: linear-gradient(135deg, var(--restaurant-primary) 0%, var(--restaurant-secondary) 100%);
            color: white;
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .nav-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            text-decoration: none;
        }
        
        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }
        
        .nav-links a {
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: opacity 0.3s;
        }
        
        .nav-links a:hover {
            opacity: 0.8;
        }
        
        .nav-links a.active {
            border-bottom: 2px solid white;
            padding-bottom: 0.25rem;
        }
        
        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }
        
        .section {
            padding: 4rem 0;
        }
        
        /* Footer */
        .restaurant-footer {
            background: #1f2937;
            color: white;
            padding: 3rem 0 1rem;
            margin-top: 4rem;
        }
        
        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .footer-section h3 {
            margin-bottom: 1rem;
            color: var(--restaurant-accent);
        }
        
        .footer-section ul {
            list-style: none;
        }
        
        .footer-section a {
            color: #d1d5db;
            text-decoration: none;
            line-height: 2;
        }
        
        .footer-section a:hover {
            color: white;
        }
        
        .footer-bottom {
            border-top: 1px solid #374151;
            padding-top: 1.5rem;
            text-align: center;
            color: #9ca3af;
            font-size: 0.875rem;
        }
        
        /* Mobile Menu */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="restaurant-nav">
        <div class="nav-container">
            <a href="/restaurant" class="nav-brand">🍽️ Tasty Bites</a>
            <ul class="nav-links">
                <li><a href="/restaurant" class="<%= page === 'home' ? 'active' : '' %>">Home</a></li>
                <li><a href="/restaurant/menu" class="<%= page === 'menu' ? 'active' : '' %>">Menu</a></li>
                <li><a href="/restaurant/reservations" class="<%= page === 'reservations' ? 'active' : '' %>">Reservations</a></li>
                <li><a href="/restaurant/about" class="<%= page === 'about' ? 'active' : '' %>">About</a></li>
                <li><a href="/restaurant/contact" class="<%= page === 'contact' ? 'active' : '' %>">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="restaurant-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Tasty Bites Restaurant</h3>
                    <p style="color: #d1d5db; line-height: 1.6;">
                        Experience culinary excellence with our modern dining platform. 
                        Fresh ingredients, innovative recipes, exceptional service.
                    </p>
                </div>
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="/restaurant">Home</a></li>
                        <li><a href="/restaurant/menu">Menu</a></li>
                        <li><a href="/restaurant/reservations">Reservations</a></li>
                        <li><a href="/restaurant/about">About Us</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Contact</h3>
                    <ul style="color: #d1d5db;">
                        <li>📍 123 Food Street, City</li>
                        <li>📞 (555) 123-4567</li>
                        <li>✉️ info@tastybites.demo</li>
                        <li>🕐 Mon-Sun: 11AM - 10PM</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>🎯 This is a demo website created by <a href="https://devx360.in" style="color: var(--restaurant-accent);">DevX360</a></p>
            </div>
        </div>
    </footer>
</body>
</html>

<section style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 4rem 0; text-align: center;">
    <div class="container">
        <h1 style="font-size: 3rem; margin-bottom: 1rem;">Contact Us</h1>
        <p style="font-size: 1.25rem; opacity: 0.95;">We'd love to hear from you</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 3rem;">
            <div>
                <h2 style="font-size: 2rem; margin-bottom: 2rem; color: #333;">Get in Touch</h2>
                <div style="display: grid; gap: 2rem;">
                    <div style="display: flex; gap: 1rem;">
                        <div style="font-size: 2rem;">📍</div>
                        <div>
                            <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #333;">Address</h3>
                            <p style="color: #666; line-height: 1.6;">123 Food Street<br>Downtown, City, 12345</p>
                        </div>
                    </div>
                    <div style="display: flex; gap: 1rem;">
                        <div style="font-size: 2rem;">📞</div>
                        <div>
                            <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #333;">Phone</h3>
                            <p style="color: #666; line-height: 1.6;">(555) 123-4567</p>
                        </div>
                    </div>
                    <div style="display: flex; gap: 1rem;">
                        <div style="font-size: 2rem;">✉️</div>
                        <div>
                            <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #333;">Email</h3>
                            <p style="color: #666; line-height: 1.6;">info@tastybites.demo</p>
                        </div>
                    </div>
                    <div style="display: flex; gap: 1rem;">
                        <div style="font-size: 2rem;">🕐</div>
                        <div>
                            <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #333;">Hours</h3>
                            <p style="color: #666; line-height: 1.6;">Monday - Sunday: 11:00 AM - 10:00 PM</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div>
                <h2 style="font-size: 2rem; margin-bottom: 2rem; color: #333;">Send a Message</h2>
                <form style="display: grid; gap: 1.5rem;">
                    <input type="text" placeholder="Your Name" style="padding: 0.875rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem;">
                    <input type="email" placeholder="Your Email" style="padding: 0.875rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem;">
                    <input type="text" placeholder="Subject" style="padding: 0.875rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem;">
                    <textarea rows="5" placeholder="Your Message" style="padding: 0.875rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem; font-family: inherit;"></textarea>
                    <button type="submit" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 1rem 2rem; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer;" onclick="alert('This is a demo. In a real application, your message would be sent!'); return false;">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

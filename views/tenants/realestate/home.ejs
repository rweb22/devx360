                <button style="background: var(--realestate-primary); color: white; padding: 1rem 2rem; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 1rem;">SEARCH</button>
            </div>
        </div>
    </div>
</section>


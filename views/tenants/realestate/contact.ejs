<section style="background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%); color: white; padding: 4rem 0; text-align: center;">
    <div class="container">
        <h1 style="font-size: 3.5rem; margin-bottom: 1rem; font-weight: 700;">Contact Us</h1>
        <p style="font-size: 1.25rem; opacity: 0.95;">Let's find your dream property together</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem; margin-bottom: 4rem;">
            <div style="background: white; padding: 2.5rem; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: var(--realestate-light); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📍</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--realestate-dark);">Visit Us</h3>
                <p style="color: #64748b; line-height: 1.8;">789 Real Estate Blvd<br>Suite 100<br>City, State 12345</p>
            </div>
            <div style="background: white; padding: 2.5rem; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: var(--realestate-light); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📞</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--realestate-dark);">Call Us</h3>
                <p style="color: #64748b; line-height: 1.8;">(555) HOME-4U<br>Mon-Sat: 9AM - 7PM<br>24/7 Emergency Line</p>
            </div>
            <div style="background: white; padding: 2.5rem; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: var(--realestate-light); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">✉️</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--realestate-dark);">Email Us</h3>
                <p style="color: #64748b; line-height: 1.8;">info@primerealty.demo<br>sales@primerealty.demo<br>24 hour response</p>
            </div>
        </div>

        <div style="max-width: 800px; margin: 0 auto;">
            <h2 style="font-size: 2.5rem; margin-bottom: 2rem; text-align: center; color: var(--realestate-dark);">Send Us a Message</h2>
            <div style="background: white; padding: 3rem; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                <form style="display: grid; gap: 1.5rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--realestate-dark);">Name *</label>
                            <input type="text" required style="width: 100%; padding: 1rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--realestate-dark);">Email *</label>
                            <input type="email" required style="width: 100%; padding: 1rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem;">
                        </div>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--realestate-dark);">Phone</label>
                        <input type="tel" style="width: 100%; padding: 1rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--realestate-dark);">I'm interested in *</label>
                        <select required style="width: 100%; padding: 1rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem;">
                            <option value="">Select option</option>
                            <option value="buying">Buying a Home</option>
                            <option value="selling">Selling a Property</option>
                            <option value="renting">Renting</option>
                            <option value="investing">Investment Properties</option>
                            <option value="commercial">Commercial Real Estate</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: var(--realestate-dark);">Message</label>
                        <textarea rows="5" style="width: 100%; padding: 1rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem; font-family: inherit;"></textarea>
                    </div>
                    <button type="submit" style="background: var(--realestate-primary); color: white; padding: 1.25rem 2rem; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; margin-top: 1rem;" onclick="alert('This is a demo. In production, your message would be sent to our team!'); return false;">
                        SEND MESSAGE
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<section style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; padding: 4rem 0; text-align: center;">
    <div class="container">
        <h1 style="font-size: 3rem; margin-bottom: 1rem; font-weight: 700;">Contact Us</h1>
        <p style="font-size: 1.25rem; opacity: 0.95;">We're here to help 24/7</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem; margin-bottom: 4rem;">
            <div style="background: white; padding: 2.5rem; border-radius: 16px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📍</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: #1e293b;">Visit Us</h3>
                <p style="color: #64748b; line-height: 1.8;">456 Medical Plaza<br>Healthcare District<br>City, State 12345</p>
            </div>
            <div style="background: white; padding: 2.5rem; border-radius: 16px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">📞</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: #1e293b;">Call Us</h3>
                <p style="color: #64748b; line-height: 1.8;">Main: (555) 123-CARE<br>Emergency: (555) 911-CARE<br>Available 24/7</p>
            </div>
            <div style="background: white; padding: 2.5rem; border-radius: 16px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); border-radius: 50%; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">✉️</div>
                <h3 style="font-size: 1.5rem; margin-bottom: 1rem; color: #1e293b;">Email Us</h3>
                <p style="color: #64748b; line-height: 1.8;">General: info@medicare-plus.demo<br>Support: support@medicare-plus.demo<br>Response within 24 hours</p>
            </div>
        </div>

        <div style="max-width: 800px; margin: 0 auto;">
            <h2 style="font-size: 2.5rem; margin-bottom: 2rem; text-align: center; color: #1e293b;">Send Us a Message</h2>
            <div style="background: white; padding: 3rem; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                <form style="display: grid; gap: 1.5rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: #1e293b;">Name *</label>
                            <input type="text" required style="width: 100%; padding: 1rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: #1e293b;">Email *</label>
                            <input type="email" required style="width: 100%; padding: 1rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem;">
                        </div>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: #1e293b;">Subject *</label>
                        <input type="text" required style="width: 100%; padding: 1rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.75rem; font-weight: 600; color: #1e293b;">Message *</label>
                        <textarea rows="6" required style="width: 100%; padding: 1rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem; font-family: inherit;"></textarea>
                    </div>
                    <button type="submit" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; padding: 1.25rem 2rem; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; margin-top: 1rem;" onclick="alert('This is a demo. In a real application, your message would be sent to our support team!'); return false;">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="section" style="background: #e0f2fe;">
    <div class="container">
        <h2 style="font-size: 2.5rem; margin-bottom: 3rem; text-align: center; color: #1e293b;">Frequently Asked Questions</h2>
        <div style="max-width: 900px; margin: 0 auto; display: grid; gap: 1.5rem;">
            <details style="background: white; padding: 1.5rem 2rem; border-radius: 12px; cursor: pointer;">
                <summary style="font-weight: 600; font-size: 1.125rem; color: #1e293b;">What are your operating hours?</summary>
                <p style="margin-top: 1rem; color: #64748b; line-height: 1.8;">Our facility is open 24/7 for emergency care. Regular appointments are available Monday-Friday 8AM-6PM, and Saturday 9AM-2PM.</p>
            </details>
            <details style="background: white; padding: 1.5rem 2rem; border-radius: 12px; cursor: pointer;">
                <summary style="font-weight: 600; font-size: 1.125rem; color: #1e293b;">Do you accept insurance?</summary>
                <p style="margin-top: 1rem; color: #64748b; line-height: 1.8;">Yes, we accept most major insurance plans. Please contact our billing department to verify your specific coverage.</p>
            </details>
            <details style="background: white; padding: 1.5rem 2rem; border-radius: 12px; cursor: pointer;">
                <summary style="font-weight: 600; font-size: 1.125rem; color: #1e293b;">How do I access my medical records?</summary>
                <p style="margin-top: 1rem; color: #64748b; line-height: 1.8;">You can access your complete medical records anytime through our secure patient portal. Simply create an account or login to view your history.</p>
            </details>
            <details style="background: white; padding: 1.5rem 2rem; border-radius: 12px; cursor: pointer;">
                <summary style="font-weight: 600; font-size: 1.125rem; color: #1e293b;">Can I do a video consultation?</summary>
                <p style="margin-top: 1rem; color: #64748b; line-height: 1.8;">Absolutely! We offer telemedicine consultations for many conditions. Book a video appointment through our platform and connect with a doctor from home.</p>
            </details>
        </div>
    </div>
</section>

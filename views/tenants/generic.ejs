<!-- Generic Demo Template (for temporary tenants) -->

<!-- Hero Section -->
<section class="hero section" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text animate-on-scroll" style="text-align: center; color: white;">
                <h1 class="hero-title" style="color: white;">
                    <%= hero.title %>
                </h1>
                <p class="hero-subtitle" style="color: rgba(255, 255, 255, 0.9); font-size: 1.25rem;">
                    <%= hero.subtitle %>
                </p>
                <div class="hero-cta" style="margin-top: 2rem;">
                    <a href="#features" class="btn btn-primary" style="background: white; color: #6366f1; font-weight: 600;">
                        <%= hero.cta %>
                    </a>
                    <a href="https://devx360.in" class="btn btn-secondary" style="background: transparent; border: 2px solid white; color: white;">
                        Learn More
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section" id="features" style="padding: 4rem 0; background: #f8f9fa;">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem;">Key Features</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
            <% features.forEach(feature => { %>
                <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;"><%= feature.icon %></div>
                    <h3 style="margin-bottom: 0.75rem; font-size: 1.5rem;"><%= feature.title %></h3>
                    <p style="color: #666; line-height: 1.6;"><%= feature.description %></p>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="section" style="padding: 4rem 0; background: #6366f1; color: white;">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem; color: white;">By The Numbers</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center;">
            <% stats.forEach(stat => { %>
                <div>
                    <div style="font-size: 3rem; font-weight: bold; margin-bottom: 0.5rem;"><%= stat.value %></div>
                    <div style="font-size: 1.25rem; opacity: 0.9;"><%= stat.label %></div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Tenant Info (if available) -->
<% if (tenant && tenant.description) { %>
<section class="section" style="padding: 4rem 0;">
    <div class="container">
        <div style="max-width: 800px; margin: 0 auto; text-align: center;">
            <h2 style="margin-bottom: 1.5rem; font-size: 2.5rem;">About This Demo</h2>
            <p style="font-size: 1.2rem; line-height: 1.8; color: #4b5563;">
                <%= tenant.description %>
            </p>
        </div>
    </div>
</section>
<% } %>

<!-- Demo Notice -->
<section class="section" style="padding: 3rem 0; background: #fef3c7; border-top: 3px solid #f59e0b;">
    <div class="container">
        <div style="text-align: center;">
            <h3 style="color: #92400e; margin-bottom: 1rem;">✨ Custom Demo Website</h3>
            <p style="color: #92400e; font-size: 1.1rem; max-width: 700px; margin: 0 auto;">
                This is a custom demo website created by DevX360 to showcase our development capabilities.
                Want a custom solution for your business?
            </p>
            <a href="https://devx360.in/contact" style="display: inline-block; margin-top: 1.5rem; padding: 0.75rem 2rem; background: #92400e; color: white; text-decoration: none; border-radius: 8px; font-weight: 600;">
                Contact DevX360
            </a>
        </div>
    </div>
</section>
